{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "package-name": "goatbeat",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "packages/goatbeat/pyproject.toml",
        "packages/goatbeat-core/pyproject.toml",
        "packages/goatbeat-postgres/pyproject.toml",
        "packages/goatbeat-django/pyproject.toml",
        "packages/goatbeat-celery/pyproject.toml",
        "packages/goatbeat-dramatiq/pyproject.toml",
        "packages/goatbeat-rq/pyproject.toml",
        "packages/goatbeat-prometheus/pyproject.toml",
        "packages/goatbeat-otel/pyproject.toml",
        "packages/goatbeat-cli/pyproject.toml",
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name===\"goatbeat\")].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name===\"goatbeat-core\")].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name===\"goatbeat-postgres\")].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name===\"goatbeat-django\")].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name===\"goatbeat-celery\")].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name===\"goatbeat-dramatiq\")].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name===\"goatbeat-rq\")].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name===\"goatbeat-prometheus\")].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name===\"goatbeat-otel\")].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name===\"goatbeat-cli\")].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name===\"goatbeat-workspace\")].version"
        }
      ]
    }
  }
}
